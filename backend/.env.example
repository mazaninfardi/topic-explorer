# Vertex AI config (auth is via Application Default Credentials — no key here)
GCP_PROJECT=topic-explorer-509403
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Postgres (async SQLAlchemy). Local dev uses the Docker instance on 5433.
DATABASE_URL=postgresql+asyncpg://postgres:dev@localhost:5433/topic_explorer

# Prod: Cloud SQL via the Python Connector (set these instead of DATABASE_URL).
# INSTANCE_CONNECTION_NAME=project:region:instance
# DB_USER=postgres
# DB_PASS=...
# DB_NAME=topic_explorer

# Session cookie signing secret (generate a real one per environment)
SESSION_SECRET=dev-insecure-secret-change-me

# Google OAuth Web client id + secret (authorization-code redirect flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public base URL of the app (OAuth redirect_uri + post-login redirect)
APP_BASE_URL=http://localhost:5173

# Anonymous/guest exploration cap
GUEST_PAPER_LIMIT=5
